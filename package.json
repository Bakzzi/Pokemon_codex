{
  "name": "pokemon-codex-buddy",
  "version": "0.3.121",
  "private": true,
  "description": "A local Pokemon desktop companion for AI agents, inspired by momozzing/Digimon_mod",
  "main": "desktop/main.cjs",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node desktop/scripts/check-parity.cjs && node --test desktop/test/*.test.cjs mobile/test/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "build:data": "node desktop/scripts/build-data.cjs",
    "build:habitats": "node desktop/scripts/build-kanto-habitats.cjs && node desktop/scripts/build-johto-habitats.cjs",
    "build:town-map": "node desktop/scripts/build-town-map.cjs",
    "mobile:bundle": "node mobile/scripts/build-web.cjs",
    "mobile:build": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/scripts/build-android.ps1",
    "mobile:test": "powershell -NoProfile -ExecutionPolicy Bypass -File mobile/scripts/verify-android.ps1",
    "package": "node desktop/scripts/package.cjs",
    "build:johto-map": "node desktop/scripts/build-johto-map.cjs",
    "build:trainers": "node desktop/scripts/build-kanto-trainers.cjs"
  },
  "devDependencies": {
    "electron": "44.7.0"
  },
  "dependencies": {
    "@pkmn/sim": "0.10.11",
    "ssh2": "1.17.0"
  }
}
